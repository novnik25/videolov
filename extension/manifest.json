{
  "manifest_version": 3,
  "name": "Видеолов",
  "version": "1.0.0",
  "description": "Находит видео на открытой странице и сохраняет его в исходном качестве. Поддерживает HLS, DASH и прямые файлы.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/scan.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Видеолов",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
